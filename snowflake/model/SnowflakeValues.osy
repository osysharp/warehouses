namespace Osysharp.Warehouses.Snowflake;

/// Turns a value as Snowflake's SQL API sends it into the text a query plan's rows carry.
///
/// The API sends every value as a string in an encoding of its own type. A `DATE` is a count of days since 1970-01-01,
/// a `TIME` a count of seconds since midnight, and a `TIMESTAMP_*` a count of seconds since the epoch — with, for
/// `TIMESTAMP_TZ`, the offset in minutes plus 1440 after a space. Numbers, booleans and text arrive as they read. Dates
/// and times come out as ISO 8601 text with seven fractional digits, which is as fine as a .NET tick.
public class SnowflakeValues {

  const string InstantWithOffset = "yyyy-MM-ddTHH:mm:ss.fffffffzzz";

  /// The text for one value, given its column's type as the response's `rowType` names it: `fixed`, `real`, `text`,
  /// `boolean`, `date`, `time`, `timestamp_ntz`, `timestamp_ltz` or `timestamp_tz`. Null stays null.
  public string? Canonical(string? value, string type) {
    if (value == null) { return null; }
    var kind = type.ToLower();
    if (kind == "date") {
      var days = (int)long.Parse(value);
      return DateOnly.FromDayNumber(DateOnly.FromDateTime(DateTime.UnixEpoch).DayNumber + days).ToString("yyyy-MM-dd");
    }
    if (kind == "time") { return TimeOnly.FromTimeSpan(TimeSpan.FromTicks(Ticks(value))).ToString("HH:mm:ss.fffffff"); }
    if (kind == "timestamp_ntz") { return InstantAt(value).UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ss.fffffff"); }
    if (kind == "timestamp_ltz") { return InstantAt(value).ToString(InstantWithOffset); }
    if (kind == "timestamp_tz") {
      var space = value.IndexOf(" ");
      if (space < 0) { return InstantAt(value).ToString(InstantWithOffset); }
      var offset = TimeSpan.FromMinutes(long.Parse(value.Substring(space + 1)) - 1440);
      return InstantAt(value.Substring(0, space)).ToOffset(offset).ToString(InstantWithOffset);
    }
    return value;
  }

  // Seconds since the epoch, as the instant they name.
  DateTimeOffset InstantAt(string seconds) {
    return DateTimeOffset.UnixEpoch.AddTicks(Ticks(seconds));
  }

  // A decimal count of seconds as ticks, truncated to a tick. A negative count with a fraction rounds toward the past,
  // so `-1.25` is 1.25 seconds before the epoch and not a quarter of a second after the second before it.
  long Ticks(string seconds) {
    return Whole(seconds) * 10000000 + Nanos(seconds) / 100;
  }

  // The whole seconds of a decimal count. A negative count with a fraction borrows one, so `Nanos` is never negative:
  // `-1.25` is -2 seconds and 750,000,000 nanoseconds.
  long Whole(string seconds) {
    var dot = seconds.IndexOf(".");
    var whole = long.Parse(dot < 0 ? seconds : seconds.Substring(0, dot));
    if (seconds.StartsWith("-") && Fraction(seconds) > 0) { return whole - 1; }
    return whole;
  }

  long Nanos(string seconds) {
    var fraction = Fraction(seconds);
    if (seconds.StartsWith("-") && fraction > 0) { return 1000000000 - fraction; }
    return fraction;
  }

  // The digits after the point, as nanoseconds.
  long Fraction(string seconds) {
    var dot = seconds.IndexOf(".");
    if (dot < 0) { return 0; }
    var digits = seconds.Substring(dot + 1);
    if (digits.Length > 9) { digits = digits.Substring(0, 9); }
    while (digits.Length < 9) { digits = digits + "0"; }
    return long.Parse(digits);
  }
}
