/// Snowflake's answer to a statement that has finished: one column, one row.
string Finished(string column, string value) {
  return "{\"code\":\"090001\",\"message\":\"Statement executed successfully.\",\"statementHandle\":\"01b-test\","
    + "\"resultSetMetaData\":{\"numRows\":1,\"format\":\"jsonv2\",\"rowType\":[{\"name\":\"" + column + "\",\"type\":\"fixed\","
    + "\"nullable\":false}],\"partitionInfo\":[{\"rowCount\":1}]},\"data\":[[\"" + value + "\"]]}";
}

[TestFixture]
void Account() {
  Secret.SnowflakePrivateKey.Stub(TestKey());
}

[Test(Account)]
void a_count_is_one_statement_signed_with_a_key_pair_jwt() {
  Http.Post.Stub((url, body, headers) => {
    Assert.Equal("https://myorg-myaccount.snowflakecomputing.com/api/v2/statements", url);
    Assert.Equal("KEYPAIR_JWT", headers["X-Snowflake-Authorization-Token-Type"]);
    // A JWT — header, claims, signature — made from the stubbed key.
    Assert.StartsWith("Bearer ey", headers["Authorization"]);
    Assert.Equal(3, headers["Authorization"].Split('.').Length);
    Assert.Contains("COUNT(", body);
    Assert.Contains("\"warehouse\":\"ANALYTICS_WH\"", body);
    return new HttpResponse { StatusCode = 200, Body = Finished("COUNT(*)", "2") };
  });

  Assert.Equal(2, Order.Count());
}

[Test(Account)]
void an_update_is_one_statement_and_answers_the_rows_snowflake_reports() {
  Http.Post.Stub((url, body, headers) => {
    Assert.Contains("UPDATE", body);
    return new HttpResponse { StatusCode = 200, Body =
      "{\"code\":\"090001\",\"statementHandle\":\"01b-update\",\"resultSetMetaData\":{\"numRows\":1,\"rowType\":[],"
      + "\"partitionInfo\":[{\"rowCount\":1}]},\"data\":[[\"3\",\"0\"]],"
      + "\"stats\":{\"numRowsInserted\":0,\"numRowsUpdated\":3,\"numRowsDeleted\":0,\"numDuplicateRowsUpdated\":0}}" };
  });

  Assert.Equal(3, Order.Where(o => o.Region == "North").Update(o => { o.Total = 0m; }));
}
