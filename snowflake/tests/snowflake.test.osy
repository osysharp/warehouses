// Osysharp.Warehouses.Snowflake — what an app's query becomes on the wire: one statement posted to the account's SQL API,
// signed with a key-pair JWT made from the app's private key, and Snowflake's answer read back as the value the query
// asked for.

using Osysharp.Http;

