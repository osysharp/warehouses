// Osysharp.Warehouses.Snowflake — Snowflake for an Osy# app, both ways: entities whose rows live in a Snowflake warehouse, read
// through Snowflake's SQL API and secured by the app's own rules; and an app's own entities exported into Snowflake
// tables as they change.
//
// It asks for one host and one secret, and an app that uses it grants them or does not compile.
package Osysharp.Warehouses.Snowflake {
  version     "0.2.3";
  minPlatform "0.9.0";
  summary     "Snowflake as a data source and an export destination: entities read from a warehouse, and changes merged into its tables.";

  model "model/*.osy";
  use Osysharp.Http;
  use Osysharp.Sources;
  use Osysharp.Exports;

  egress "*.snowflakecomputing.com";
  secret "SnowflakePrivateKey";
  tests "tests";
}
